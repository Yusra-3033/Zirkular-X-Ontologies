# baseURI: http://example.org/RUB_abox.ttl
# imports: http://example.org/RUB_tbox
# prefix: RUB_abox

@prefix RUB_abox: <http://example.org/RUB_abox.ttl#> .
@prefix eudpp: <https://purl.org/eudpp#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/RUB_abox.ttl>
  rdf:type owl:Ontology ;
  owl:imports <http://example.org/RUB_tbox> ;
  owl:versionInfo "Created with TopBraid Composer" ;
.

# --- Product ---
RUB_abox:Lüfter_1
  rdf:type eudpp:Product ;
  rdfs:label "Lüfter 01"@de ;
  eudpp:hasUniqueProductIdentifier RUB_abox:UPI_Lüfter_01 ;
  eudpp:hasDPP RUB_abox:DPP_Lüfter_01 ;
.

# --- Unique Product Identifier (EN 18219) ---
RUB_abox:UPI_Lüfter_01
  rdf:type eudpp:ProductIdentifier ;
  rdfs:label "Unique Product Identifier - Lüfter 01"@en ;
  eudpp:identifierValue "X-AIR-12.5-A-08-11942" ;
  eudpp:hasGranularity eudpp:item ;
  eudpp:hasScheme RUB_abox:RUB_IdScheme ;
.

RUB_abox:RUB_IdScheme
  rdf:type eudpp:ProductIdentifierScheme ;
  rdfs:label "RUB Zirkular-X Product ID Scheme"@en ;
  eudpp:identifierSchemeIssuer "Ruhr-Universität Bochum / Zirkular-X" ;
.

# --- DPP + DPP Identifier ---
RUB_abox:DPP_Lüfter_01
  rdf:type eudpp:DPP ;
  rdfs:label "Digital Product Passport - Lüfter 01"@en ;
  eudpp:appliesToProduct RUB_abox:Lüfter_1 ;
  eudpp:hasDigitalProductPassportId RUB_abox:DPPID_Lüfter_01 ;
.

RUB_abox:DPPID_Lüfter_01
  rdf:type eudpp:DPPIdentifier ;
  rdfs:label "DPP Identifier - Lüfter 01"@en ;
  eudpp:identifierValue "urn:rub:zirkular-x:dpp:11942" ;
.
