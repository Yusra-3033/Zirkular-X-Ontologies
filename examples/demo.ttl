# baseURI: https://w3id.org/zirkular-x/example/demo
# prefix: demo

@prefix dpp-comp: <http://w3id.org/dppo/ontology/dpp-comp/> .
@prefix dpp-core: <http://w3id.org/dppo/ontology/dpp-core/> .
@prefix dpp-info: <http://w3id.org/dppo/ontology/dpp-info/> .
@prefix dpp-odp: <http://w3id.org/dppo/ontology/dpp-odp/> .
@prefix dpp-prov: <http://w3id.org/dppo/ontology/dpp-prov/> .
@prefix ex: <https://w3id.org/zirkular-x/example/demo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix zx: <https://w3id.org/zirkular-x/ext#> .
@prefix zxd: <https://w3id.org/zirkular-x/dictionary#> .

<https://w3id.org/zirkular-x/example/demo>
  rdf:type owl:Ontology ;
  rdfs:comment "Hand-built passport on the hand-built TBox, coverage parity with the EuDPP-side example: Parameterliste rows 1..32 (through Materialzusammensetzung)."@en ;
  owl:imports <https://w3id.org/zirkular-x/dppo-conn> ;
  owl:imports <https://w3id.org/zirkular-x/dppo-shapes> .

# --- actors ---
ex:facility-manager a dpp-prov:ValueChainActor ; rdfs:label "Facility management" .

ex:muster-gmbh a dpp-prov:ValueChainActor , vcard:Organization ;
  rdfs:label "Muster Klimatechnik GmbH" ;
  vcard:fn "Muster Klimatechnik GmbH" ;
  vcard:hasAddress [ a vcard:Address ;
      vcard:street-address "Musterallee 12" ;
      vcard:postal-code "44801" ;
      vcard:locality "Bochum" ;
      vcard:country-name "DE" ] ;
  vcard:hasTelephone [ a vcard:Voice ; vcard:hasValue <tel:+49-234-000000> ] ;
  vcard:hasEmail <mailto:info@muster-klima.example> ;
  vcard:hasURL <https://www.muster-klima.example> .

# --- the machine and its parts ---
ex:rlt-01 a zx:VentilationUnit ;
  rdfs:label "Air handling unit RLT-01" ;
  dpp-odp:hasPart ex:fan-01 ;
  zx:hasIdentifier ex:id-rlt-01 .

ex:fan-01 a zx:Fan ; rdfs:label "Supply air fan" .

ex:mat-steel a dpp-core:Material ; rdfs:label "Verzinktes Stahlblech (pulverbeschichtet, Gehaeusewaende)"@de .
ex:mat-alu a dpp-core:Material ; rdfs:label "Aluminium (Rahmenprofile, Rotorstruktur)"@de .
ex:mat-copper a dpp-core:Material ; rdfs:label "Kupfer (Registerrohre)"@de .
ex:mat-mineralwool a dpp-core:Material ; rdfs:label "Mineralwolle (Gehaeusedaemmung, nicht brennbar, 50 mm)"@de .
ex:mat-plastics a dpp-core:Material ; rdfs:label "Kunststoffe/Elastomere (Dichtungen, Filterrahmen, Griffe)"@de .
ex:mat-electronics a dpp-core:Material ; rdfs:label "Elektronik/Leistungshalbleiter (Motoren, Umrichter)"@de .

# --- identifier (EN 18219; row 1 legacy value kept) ---
ex:id-rlt-01 a zx:Identifier ;
  zx:identifierValue "https://id.zirkular-x.example/01/rlt-01" ;
  zx:legacyIdentifierValue "RLT-1998-0042" ;
  zx:granularity zx:item .

# --- the passport ---
ex:dpp-rlt-01 a dpp-odp:DPP ;
  dpp-odp:describes ex:rlt-01 ;
  dpp-prov:dppOwner ex:muster-gmbh ;
  dpp-prov:creationTimeStamp "2026-09-10T08:30:00Z"^^xsd:dateTime ;
  zx:uniqueProductIdentifier "https://id.zirkular-x.example/01/rlt-01"^^xsd:anyURI ;
  zx:dppStatus zx:active ;
  dpp-info:containsInformation ex:st-airflow ,
    ex:st-place-mfg , ex:st-date-mfg , ex:st-use , ex:st-users , ex:st-conditions , ex:st-life-avg , ex:st-life-min , ex:st-dimensions , ex:st-weight , ex:st-category , ex:st-status , ex:st-hazard , ex:st-crm , ex:st-recycled , ex:st-renewable , ex:st-reused , ex:st-separable , ex:st-biodegradable ,
    ex:st-material-steel , ex:st-material-alu , ex:st-material-copper , ex:st-material-mineralwool , ex:st-material-plastics , ex:st-material-electronics ,
    ex:class-din276 , ex:class-cpr , ex:ev-production , ex:ev-disassembly-fan .

# --- her original fact, unchanged ---
ex:st-airflow
  rdf:type zx:ParameterStatement ;
  zx:elementId "rlt-01.airflow.1" ;
  dpp-info:isAbout ex:rlt-01 ;
  dpp-info:characteristic zxd:AirflowRate ;
  dpp-info:value "5000.0"^^xsd:decimal ;
  dpp-prov:responsibleActor ex:facility-manager ;
  dpp-prov:creationTimeStamp "2026-09-10T08:31:00Z"^^xsd:dateTime .

# --- product information, rows 4..16 and material block rows 26..32 ---
